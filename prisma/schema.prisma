generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                Int      @id @default(autoincrement())
  email             String   @unique
  username          String   @unique
  password          String
  balance           Float    @default(0)
  tokenBalance      Float    @default(0)
  boundTokenBalance Float    @default(0)
  energyPoints      Int      @default(0)
  hashpowerVirtual  Float    @default(0)
  level             Int      @default(1)
  xp                Int      @default(0)
  createdAt         DateTime @default(now())
}
