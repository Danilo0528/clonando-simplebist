generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                Int      @id @default(autoincrement())
  email             String   @unique
  username          String   @unique
  password          String
  balance           Float    @default(0)
  tokenBalance      Float    @default(0)
  boundTokenBalance Float    @default(0)
  energyPoints      Int      @default(100)
  hashpowerVirtual  Float    @default(0)
  totalHashrate     Float    @default(0) // Hashrate total acumulado del hardware
  level             Int      @default(1)
  xp                Int      @default(0)
  isAdmin           Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lastFaucetClaim   DateTime?
  lastMiningClaim   DateTime? // Última vez que reclamó recompensas de minería
  lastEnergyUpdate  DateTime?
  failedLoginAttempts Int    @default(0)
  lockoutExpiresAt  DateTime?
  lastFaucetRequest DateTime? // Para rate limiting anti-bots
  faucetAttempts    Int      @default(0) // Contador de intentos en ventana de tiempo
  
  // Relaciones
  inventory         InventoryItem[]
  withdrawals       Withdrawal[]
}

model InventoryItem {
  id          Int      @id @default(autoincrement())
  userId      Int
  itemId      Int      // ID del item comprado
  itemName    String   // Nombre del item
  itemType    String   // hardware, consumable, booster
  hashrate    Float    @default(0) // Hashrate que aporta este item
  quantity    Int      @default(1)
  purchasedAt DateTime @default(now())
  expiresAt   DateTime? // Para items temporales
  
  user        User     @relation(fields: [userId], references: [id])
  
  @@index([userId])
}

model MarketItem {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  price       Float
  type        String   // hardware, consumable, booster
  hashrate    Float    @default(0) // Hashrate que aporta (si es hardware)
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  type        String   @default("info") // info, update, event, warning
  isActive    Boolean  @default(true)
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  category  String   @default("general")
  updatedAt DateTime @updatedAt
}

model Withdrawal {
  id              Int      @id @default(autoincrement())
  userId          Int
  amount          Float
  cryptoCurrency  String
  address         String
  fee             Float    @default(0)
  netAmount       Float
  status          String   @default("pending") // pending, processing, completed, rejected
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User     @relation(fields: [userId], references: [id])
  
  @@index([userId])
}
