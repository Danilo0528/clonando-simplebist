generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String   @id // Cambiado a String para UUID de Supabase
  email             String   @unique
  username          String   @unique
  password          String?  // Supabase Auth maneja la pass, hacemos opcional
  balance           Float    @default(0)
  tokenBalance      Float    @default(0)
  boundTokenBalance Float    @default(0)
  energyPoints      Int      @default(100)
  hashpowerVirtual  Float    @default(0)
  totalHashrate     Float    @default(0) 
  level             Int      @default(1)
  xp                Int      @default(0)
  isAdmin           Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lastFaucetClaim   DateTime?
  lastMiningClaim   DateTime? 
  lastEnergyUpdate  DateTime?
  failedLoginAttempts Int    @default(0)
  lockoutExpiresAt  DateTime?
  lastFaucetRequest DateTime? 
  faucetAttempts    Int      @default(0) 
  
  // Relaciones
  inventory         InventoryItem[]
  withdrawals       Withdrawal[]
  rentalContracts   RentalContract[]
}

model InventoryItem {
  id          Int      @id @default(autoincrement())
  userId      String   // Cambiado a String
  itemId      Int      
  itemName    String   
  itemType    String   
  hashrate    Float    @default(0) 
  quantity    Int      @default(1)
  purchasedAt DateTime @default(now())
  expiresAt   DateTime? 
  
  user        User     @relation(fields: [userId], references: [id])
  
  @@index([userId])
}

model MarketItem {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  price       Float
  type        String   
  hashrate    Float    @default(0) 
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  type        String   @default("info") 
  isActive    Boolean  @default(true)
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  category  String   @default("general")
  updatedAt DateTime @updatedAt
}

model Withdrawal {
  id              Int      @id @default(autoincrement())
  userId          String   // Cambiado a String
  amount          Float
  cryptoCurrency  String
  address         String
  fee             Float    @default(0)
  netAmount       Float
  status          String   @default("pending") 
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User     @relation(fields: [userId], references: [id])
  
  @@index([userId])
}

model PTCAd {
  id            Int      @id @default(autoincrement())
  title         String
  description   String?
  reward        Float
  estimatedTime Int      
  url           String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model RentalContract {
  id              Int      @id @default(autoincrement())
  userId          String   // Cambiado a String
  marketItemId    Int
  amountPaid      Float
  expectedPayout  Float
  durationDays    Int      @default(0)
  startTime       DateTime @default(now())
  endTime         DateTime
  lastClaimTime   DateTime?
  status          String   @default("active") 
  
  user            User     @relation(fields: [userId], references: [id])
}
